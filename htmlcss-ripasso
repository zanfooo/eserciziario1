<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Esercizio HTML e CSS</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Benvenuto nella mia pagina</h1>
    <p>esercitazione di HTML e CSS</p>

    <form action="#" method="post">
        <label for="nome">Nome:</label>
        <input type="text" id="nome" name="nome" placeholder="Scrivi il tuo nome">

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" placeholder="Scrivi la tua email">

        <button type="submit">Invia</button>
    </form>

    <div class="box">
        
 box di prova 

    </div>
</body>
</html>


/* Stile generale */
body {
    font-family: Arial, sans-serif;
    background-color: #f9f9f9;
    margin: 20px;
}

/* Titolo */
h1 {
    color: #2c3e50;
    text-align: center;
}

/* Form */
form {
    background-color: #ffffff;
    padding: 15px;
    border: 1px solid #ccc;
    max-width: 300px;
    margin: 20px auto;
    display: block;
}

label {
    display: block;
    margin-top: 10px;
}

input {
    width: 100%;
    padding: 5px;
    margin-top: 5px;
    box-sizing: border-box; /* parte del box-model */
}

button {
    margin-top: 10px;
    background-color: #3498db;
    color: white;
    border: none;
    padding: 8px;
    cursor: pointer;
}

button:hover {
    background-color: #2980b9;
}

/* Box di prova */
.box {
    margin: 20px auto;
    padding: 20px;
    border: 2px solid #333;
    width: 250px;
    background-color: #eaeaea;
    text-align: center;
}